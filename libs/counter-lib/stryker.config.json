{
    "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "inPlace": true,
    "mutate": [
        "src/lib/counter-lib/counter-lib.ts",
        "!src/lib/counter-lib/counter-lib.spec.ts",
        "!apps/counter-app-e2e/src/example.spec.ts",
        "!src/test-setup.ts"
    ],
    "coverageAnalysis": "perTest",
    "testRunner": "jest",
    "concurrency": 4,
    "reporters": [
        "progress",
        "clear-text",
        "html",
        "json"
    ],
    "htmlReporter": {
        "fileName": "reports/mutation/counter-lib/mutation.html"
    },
    "jsonReporter": {
        "fileName": "reports/mutation/counter-lib/mutation.json"
    },
    "cleanTempDir": true
}